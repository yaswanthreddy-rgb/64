body{
    margin:2px ;
    background:#2dd0f0;
    color:rgb(255, 255, 255);
    font-family:Arial,sans-serif;
}

/* Layout */
.container{
    display:flex;
}

/* Sidebar */
.sidebar{
    width:280px;
    min-height:100vh;
    padding:20px;
    background:#071330;
}

.sidebar a{
    text-decoration:none;
    color:white;
}

/* Icon Buttons */
.icon-box{
    width:200px;
    height:50px;
    background:skyblue;
    border: radius 20px;
    display:flex;
    justify-content:center;
    align-items:center;
    margin: 15px;
    box-shadow:0 4px 15px rgba(109,93,252,0.4);
}

.white{
    background:#31d55d;
}

.orange{
    background:rgb(7, 169, 233);
}

.red{
    background:red;
}

.pink{
    background:rgb(161,95,106);
}

.blue{
    background:blue;
}

.blueviolet{
    background:blueviolet;
}

/* Main Content */
.main-content{
    flex: 1;
    padding:20px;
    border: 3px solid white;
}

/* Cards Row */
.content{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
    margin-top:20px;
}

/* Cards */
.card{
    width:180px;
    height:100px;
    background:#162447;
    border-radius:15px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
    box-shadow:0 4px 15px rgba(0,0,0,0.4);
}
